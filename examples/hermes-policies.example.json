{
  "schema_version": 1,
  "projects": [
    {
      "root": "/ABSOLUTE/PATH/TO/YOUR/PROJECT",
      "commands": [
        {
          "id": "unit-tests",
          "argv": [
            "/ABSOLUTE/PATH/TO/YOUR/PROJECT/.venv/bin/python",
            "-m",
            "pytest",
            "-q",
            "--junitxml=junit.xml"
          ],
          "junit_xml": "junit.xml",
          "timeout_seconds": 180,
          "max_output_bytes": 262144
        }
      ]
    }
  ]
}
